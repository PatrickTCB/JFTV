.DS_Store

# Editor / agent scratch. Nothing in these belongs in the repo.
.claude/
.cursor/

# Xcode
Nostalgex/build/
Nostalgex/DerivedData/
build-archive/
*.xcuserstate
xcuserdata/

# Secrets — never commit real keys.
# (TMDBConfig.swift is committed but reads from env/Info.plist; Secrets.xcconfig holds the
#  Supabase values. The App Store Connect .p8 for scripts/release-tvos.sh / asc.mjs lives in
#  ~/.appstoreconnect, and a committed one would be a serious leak.)
Secrets.plist
Secrets.xcconfig
*.secret.xcconfig
TMDBConfig.local.swift
.env
.env.*
*.env
*.p12
*.p8
AuthKey_*.p8
*.mobileprovision
*.pem
*.key
